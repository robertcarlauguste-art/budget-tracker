# Copy this file to .env and fill in your values
# Never commit .env to git

# Anthropic API key — get it from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google AI API key — for Imagen 3 image generation
# Get it from https://aistudio.google.com/app/apikey (free quota available)
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Path to your Google OAuth credentials JSON (default is already set in config.py)
# GOOGLE_CREDENTIALS_PATH=chief_of_staff/credentials/credentials.json
